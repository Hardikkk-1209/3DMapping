# URL reachable from the browser running the Next.js control station.
NEXT_PUBLIC_WORKER_URL=http://localhost:8080

# Optional access key. This is sent by the browser, so it is NOT a secret.
# Use it only to keep an otherwise private worker from accepting casual requests.
# NEXT_PUBLIC_WORKER_API_KEY=change-me

# Remote GPU worker example:
# NEXT_PUBLIC_WORKER_URL=http://192.168.1.50:8080
